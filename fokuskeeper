#!/bin/bash
# FokusKeeper CLI — process management for the FokusKeeper daemon.
# Data commands (stats, history, report, reset, setup) are delegated to
# fokuskeeper.py, which owns all state and reporting logic.

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="$HOME/Library/Logs/fokuskeeper.log"
STDOUT_LOG="$HOME/Library/Logs/fokuskeeper-stdout.log"

if [ -x "$DIR/.venv/bin/python3" ]; then
    PY="$DIR/.venv/bin/python3"
else
    PY="python3"
fi

is_running() {
    pgrep -f 'python.*fokuskeeper.py' > /dev/null
}

usage() {
    echo "FokusKeeper CLI"
    echo ""
    echo "Usage: fokuskeeper <command>"
    echo ""
    echo "Process commands:"
    echo "  start     - Start the daemon"
    echo "  stop      - Stop the daemon"
    echo "  restart   - Restart the daemon"
    echo "  status    - Daemon state and today's stats"
    echo "  logs      - View recent logs"
    echo ""
    echo "Data commands (handled by fokuskeeper.py):"
    echo "  stats     - Today's statistics"
    echo "  history   - Last 7 days"
    echo "  report    - Comprehensive all-time report"
    echo "  reset     - Reset today's counts"
    echo "  setup     - Interactive configuration"
}

case "$1" in
    start)
        if is_running; then
            echo "FokusKeeper is already running."
            exit 1
        fi
        cd "$DIR" || exit 1
        # -u: unbuffered stdout, so the log fills in real time instead of
        # sitting in Python's default block-buffer when redirected to a file
        # (a fully-buffered-but-running daemon looks identical to a stuck
        # one in `fokuskeeper logs` until enough output accumulates to flush).
        nohup "$PY" -u fokuskeeper.py run > "$STDOUT_LOG" 2>&1 &
        sleep 1
        if is_running; then
            echo "FokusKeeper started."
        else
            echo "FokusKeeper failed to start. Check: $STDOUT_LOG" >&2
            exit 1
        fi
        ;;
    stop)
        pkill -f 'python.*fokuskeeper.py'
        echo "FokusKeeper stopped."
        ;;
    restart)
        pkill -f 'python.*fokuskeeper.py'
        sleep 1
        exec "$DIR/fokuskeeper" start
        ;;
    status)
        exec "$PY" "$DIR/fokuskeeper.py" status
        ;;
    logs)
        if [ -f "$LOG_FILE" ]; then
            tail -20 "$LOG_FILE"
        else
            echo "No logs found at $LOG_FILE"
        fi
        echo ""
        echo "Daemon stdout log: $STDOUT_LOG"
        ;;
    stats|history|report|reset|setup)
        exec "$PY" "$DIR/fokuskeeper.py" "$1"
        ;;
    *)
        usage
        ;;
esac
